---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title="Stack" description={`Tools and technologies ${profile.name} works with.`}>
	<h1 class="type text-[28px] leading-normal font-bold text-ink sm:text-[32px] lg:text-[38px]" style="--n: 5">
		Stack
	</h1>
	<p class="rise mt-2 max-w-[60ch]" style="--i: 1">
		What I use to ship web, mobile, and back-end work.
	</p>

	<ul class="mt-8 border-t border-hairline">
		{
			profile.stack.map(({ label, items }) => (
				<li class="reveal border-b border-hairline py-3 sm:grid sm:grid-cols-[8rem_1fr] sm:items-baseline">
					<span class="mb-2 block text-mute sm:mb-0">{label}</span>
					<ul class="flex flex-wrap gap-2">
						{items.map((item) => (
							<li class="rounded-sm bg-surface-card px-3 py-1 text-ink">{item}</li>
						))}
					</ul>
				</li>
			))
		}
	</ul>
</Layout>
