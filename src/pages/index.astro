---
import Layout from '../layouts/Layout.astro';
import AsciiWordmark from '../components/AsciiWordmark.astro';
import PageTitle from '../components/PageTitle.astro';
import { profile } from '../data/profile';
---

<Layout>
	<div class="grid gap-10 lg:grid-cols-[1fr_23rem] lg:items-center">
		<div>
			<p class="rise mb-4">
				<span class="rounded-sm bg-ink px-2 py-0.5 text-sm leading-loose text-canvas">
					{profile.age} · {profile.location}
				</span>
			</p>
			<PageTitle text={profile.name} order={1} />
			<p class="rise font-medium text-ink" style="--i: 2">{profile.role}</p>
			<p class="rise mt-4 max-w-[60ch]" style="--i: 3">{profile.bio}</p>
			<div class="rise mt-8 flex flex-wrap gap-3" style="--i: 4">
				<a
					href="/about"
					class="inline-flex h-10 items-center rounded-sm bg-ink px-5 leading-loose font-medium text-canvas active:bg-ink-deep"
				>
					About me →
				</a>
				<a
					href="/stack"
					class="inline-flex h-10 items-center rounded-sm border border-hairline-strong bg-canvas px-5 leading-loose font-medium text-ink active:bg-surface-card"
				>
					Stack
				</a>
			</div>
		</div>
		<AsciiWordmark />
	</div>
</Layout>
