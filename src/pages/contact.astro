---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import { profile } from '../data/profile';
---

<Layout title="Contact" description={`Contact ${profile.name}.`}>
	<PageTitle text="Contact" />
	<p class="rise mt-2 max-w-[60ch]" style="--i: 1">
		Building something for the web or mobile? Send me a message.
	</p>

	<ul class="mt-8 border-t border-hairline">
		{
			profile.contact.map(({ label, text, href }) => (
				<li class="reveal border-b border-hairline sm:grid sm:grid-cols-[10rem_1fr] sm:items-baseline">
					<span class="block pt-3 font-medium text-ink sm:py-3">[+] {label}</span>
					<a
						href={href}
						target={href.startsWith('http') ? '_blank' : undefined}
						rel="noopener noreferrer"
						class="inline-flex min-h-11 items-center py-2 pl-8 break-all text-ink underline underline-offset-4 sm:pl-0"
					>
						{text}
					</a>
				</li>
			))
		}
	</ul>
</Layout>
