---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Starfield from '../components/Starfield.astro';
import { profile } from '../data/profile';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title, description = profile.bio, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);

// Person schema on the home page only; it describes the site owner, not each page.
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.role,
	description: profile.bio,
	url: new URL('/', Astro.site).href,
	address: { '@type': 'PostalAddress', addressLocality: 'Tashkent', addressCountry: 'UZ' },
	knowsAbout: profile.skills,
	sameAs: profile.contact.filter(({ href }) => href.startsWith('http')).map(({ href }) => href),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />
		<meta name="theme-color" content="#fdfcfc" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<script is:inline>
			// Apply the saved theme (root class and browser chrome colour) before paint, on the
			// document ClientRouter swaps in, and when ThemeToggle flips it.
			const applyTheme = (doc = document) => {
				const dark = localStorage.getItem('theme') === 'dark';
				doc.documentElement.classList.toggle('dark', dark);
				doc.querySelector('meta[name="theme-color"]').content = dark ? '#201d1d' : '#fdfcfc';
			};
			applyTheme();
			document.addEventListener('astro:before-swap', (e) => applyTheme(e.newDocument));
		</script>
		<Font cssVariable="--font-jetbrains" preload />
		<ClientRouter />
	</head>
	<body class="flex min-h-dvh flex-col bg-canvas font-mono text-body antialiased lg:h-dvh">
		<Starfield />
		<div class="scroll-progress" aria-hidden="true"></div>
		<a
			href="#main"
			class="sr-only rounded-sm bg-ink px-3 py-1 text-canvas focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
		>
			Skip to content
		</a>
		<Nav />
		<!-- lg+: page is exactly one screen tall; content centers, and scrolls inside main if it ever overflows. -->
		<main
			id="main"
			class="flex flex-1 flex-col lg:overflow-y-auto"
			transition:animate={fade({ duration: '0.35s' })}
		>
			<div class="mx-auto my-auto w-full max-w-240 px-4 pt-12 pb-28 sm:px-6 md:py-16 lg:py-8">
				<slot />
			</div>
		</main>
	</body>
</html>
