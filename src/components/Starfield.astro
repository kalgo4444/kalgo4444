<!-- Star Surge: persisted so the field keeps flying across page navigations. -->
<canvas
	id="starfield"
	class="pointer-events-none fixed inset-0 -z-10 size-full"
	aria-hidden="true"
	transition:persist></canvas>
<script>
	// Stars spawn near the centre and rush outward, accelerating: twinkling points in the
	// core, streaks at the rim. Drawn in the brand ink colour, so it follows light/dark.
	const STARS = 200;
	const canvas = document.getElementById('starfield') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	const root = document.documentElement;
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
	// Reduced motion has no loop, so a theme switch or resize must repaint the still frame.
	const repaint = () => reduced && requestAnimationFrame(frame);

	let ink = '';
	const readInk = () => (ink = getComputedStyle(root).getPropertyValue('--color-ink').trim());
	readInk();
	new MutationObserver(() => (readInk(), repaint())).observe(root, {
		attributes: true,
		attributeFilter: ['class'],
	});

	let dpr = 1;
	let reach = 0; // centre to corner, in canvas px
	const resize = () => {
		dpr = Math.min(devicePixelRatio, 2);
		canvas.width = innerWidth * dpr;
		canvas.height = innerHeight * dpr;
		reach = Math.hypot(canvas.width, canvas.height) / 2;
	};
	resize();
	addEventListener('resize', () => (resize(), repaint()));

	// d is the distance from the centre as a fraction of reach.
	const stars = Array.from({ length: STARS }, () => ({
		a: Math.random() * Math.PI * 2,
		d: Math.random(),
		t: Math.random() * Math.PI * 2,
	}));

	let last = performance.now();
	const frame = (now: number) => {
		const dt = Math.min((now - last) / 1000, 0.05);
		last = now;
		const cx = canvas.width / 2;
		const cy = canvas.height / 2;
		ctx.clearRect(0, 0, canvas.width, canvas.height);
		ctx.strokeStyle = ink;
		ctx.lineCap = 'round';
		for (const s of stars) {
			const v = 0.04 + s.d * 0.9;
			s.d += v * dt;
			if (s.d > 1) {
				s.a = Math.random() * Math.PI * 2;
				s.d = Math.random() * 0.05;
			}
			const tail = Math.max(s.d - v * 0.07, 0);
			const twinkle = s.d < 0.2 ? 0.6 + 0.4 * Math.sin(now / 180 + s.t) : 1;
			ctx.globalAlpha = Math.min(s.d * 4, 1) * 0.3 * twinkle;
			ctx.lineWidth = (0.6 + s.d * 1.6) * dpr;
			const cos = Math.cos(s.a);
			const sin = Math.sin(s.a);
			ctx.beginPath();
			ctx.moveTo(cx + cos * tail * reach, cy + sin * tail * reach);
			ctx.lineTo(cx + cos * s.d * reach, cy + sin * s.d * reach);
			ctx.stroke();
		}
		if (!reduced) requestAnimationFrame(frame);
	};
	requestAnimationFrame(frame);
</script>
