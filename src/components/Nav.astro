---
import { nav } from '../data/profile';
import { cell, pixels } from '../data/wordmark';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (path === href ? 'page' : undefined);

// Lucide icons (24x24 stroke), keyed by route.
const icons: Record<string, string> = {
	'/': '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
	'/about': '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
	'/stack':
		'<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>',
	'/contact': '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
};

// The "A" logo mark glitches on hover: two ghost copies flash offset behind it (see .glitch-* in global.css).
const aPixels = pixels.filter(({ x }) => x < 5 * cell);
const ghosts = [
	{ fill: 'var(--color-ash)', dx: '-2px' },
	{ fill: 'var(--color-mute)', dx: '2px' },
];

// Desktop bar: Contact is the button, Home is the logo. Mobile dock lists all four.
const links = nav.filter(({ href }) => href !== '/' && href !== '/contact');
---

<header class="sticky top-0 z-40 hidden px-4 pt-3 sm:px-6 md:block" transition:animate="none">
	<nav
		aria-label="Primary"
		class="mx-auto flex max-w-240 items-center justify-between border border-hairline bg-canvas p-2"
	>
		<a href="/" aria-label="Home" class="logo flex items-center gap-3 rounded-sm">
			<span class="grid size-10 place-items-center rounded-sm bg-ink text-canvas">
				<svg
					viewBox={`0 0 ${5 * cell} ${5 * cell}`}
					class="size-6 overflow-visible"
					fill="currentColor"
					shape-rendering="crispEdges"
					aria-hidden="true"
				>
					{
						ghosts.map(({ fill, dx }) => (
							<g class="glitch-ghost" style={`--dx:${dx}`} {fill}>
								{aPixels.map(({ x, y }) => (
									<rect {x} {y} width={cell} height={cell} />
								))}
							</g>
						))
					}
					<g class="glitch-main">
						{aPixels.map(({ x, y }) => (
							<rect {x} {y} width={cell} height={cell} />
						))}
					</g>
				</svg>
			</span>
			<svg
				viewBox={`0 0 ${17 * cell} ${5 * cell}`}
				class="h-5 text-ink"
				fill="currentColor"
				shape-rendering="crispEdges"
				aria-hidden="true"
			>
				{
					pixels.map(({ x, y }) => (
						<rect class="px" style={`--c:${x / cell}`} {x} {y} width={cell} height={cell} />
					))
				}
			</svg>
		</a>
		<ul class="flex items-center gap-1">
			{
				links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							aria-current={isCurrent(href)}
							class="inline-flex h-11 items-center rounded-sm px-3 font-medium text-mute underline-offset-4 transition-colors hover:text-ink hover:underline aria-[current=page]:text-ink"
						>
							{label}
						</a>
					</li>
				))
			}
			<li class="ml-1"><ThemeToggle /></li>
			<li class="ml-1">
				<a
					href="/contact"
					aria-current={isCurrent('/contact')}
					class="inline-flex h-10 items-center rounded-sm bg-ink px-5 leading-loose font-medium text-canvas active:bg-ink-deep"
				>
					contact
				</a>
			</li>
		</ul>
	</nav>
</header>

<nav
	aria-label="Primary"
	class="fixed inset-x-0 bottom-4 z-40 flex justify-center md:hidden"
	transition:animate="none"
>
	<ul class="flex items-center gap-1 border border-hairline bg-canvas p-1.5">
		{
			nav.map(({ href, label }) => (
				<li>
					<a
						href={href}
						aria-label={label}
						aria-current={isCurrent(href)}
						class="group inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-sm text-mute transition-colors motion-safe:active:scale-95 aria-[current=page]:bg-ink aria-[current=page]:px-4 aria-[current=page]:font-bold aria-[current=page]:text-canvas"
					>
						<svg
							viewBox="0 0 24 24"
							class="size-5"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							set:html={icons[href]}
						/>
						<span class="hidden group-aria-[current=page]:inline">{label}</span>
					</a>
				</li>
			))
		}
		<li><ThemeToggle /></li>
	</ul>
</nav>
