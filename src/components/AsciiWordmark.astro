---
// The hero's one dark surface (DESIGN.md hero-tui-mockup): the ABU wordmark as 3D blocks,
// rendered by three.js and printed as ASCII text, so the 3D element is still just type.
import { cell, pixels } from '../data/wordmark';

const COLS = 64;
const ROWS = 16;

// Flat wordmark (3x2 characters per pixel): shown until the script takes over, and kept when
// JS or WebGL is unavailable.
const left = Math.floor((COLS - 17 * 3) / 2);
const top = (ROWS - 5 * 2) / 2;
const grid = Array.from({ length: ROWS }, () => Array<string>(COLS).fill(' '));
for (const { x, y } of pixels)
	for (let r = 0; r < 2; r++)
		for (let c = 0; c < 3; c++) grid[top + (y / cell) * 2 + r][left + (x / cell) * 3 + c] = '#';
const flat = grid.map((row) => row.join('')).join('\n');
---

<figure
	role="img"
	aria-label="ABU wordmark as 3D blocks, drawn in ASCII characters"
	class="rise @container max-w-md bg-ink p-4 text-canvas dark:bg-surface-card dark:text-ink"
	style="--i: 5"
>
	<!-- One character is 0.6em wide, so this font size makes COLS characters span the figure. -->
	<pre
		data-ascii-wordmark
		data-cols={COLS}
		data-rows={ROWS}
		class="cursor-grab touch-pan-y overflow-hidden leading-none select-none active:cursor-grabbing"
		style={`font-size: calc(100cqw / ${COLS * 0.6})`}>{flat}</pre>
	<figcaption class="mt-2 text-sm leading-loose">
		drag <span class="text-ash dark:text-mute">turn the wordmark</span>
	</figcaption>
</figure>

<script>
	import { animate } from 'motion';
	import {
		AmbientLight,
		BoxGeometry,
		DirectionalLight,
		Group,
		Mesh,
		MeshLambertMaterial,
		PerspectiveCamera,
		Scene,
		WebGLRenderer,
		WebGLRenderTarget,
	} from 'three';
	import { cell, pixels } from '../data/wordmark';

	const RAMP = ' .:-=+*#'; // dark to bright
	const REST = { x: 0.22, y: -0.5 }; // three-quarter pose, in radians

	function mount(pre: HTMLElement) {
		const cols = Number(pre.dataset.cols);
		const rows = Number(pre.dataset.rows);

		let renderer: WebGLRenderer;
		try {
			renderer = new WebGLRenderer();
		} catch {
			return; // no WebGL: the flat wordmark stays
		}
		// The scene is drawn one pixel per character, then read back and printed.
		const target = new WebGLRenderTarget(cols, rows);
		const buffer = new Uint8Array(cols * rows * 4);

		const scene = new Scene();
		// Lit from the camera, so the front face prints solid and the sides fall off with the turn.
		const light = new DirectionalLight(0xffffff, 3.6);
		light.position.set(0, 0, 1);
		scene.add(light, new AmbientLight(0xffffff, 0.15));

		const camera = new PerspectiveCamera(28, (cols * 0.6) / rows, 1, 100);
		camera.position.z = 19;

		const word = new Group();
		const block = new BoxGeometry(1, 1, 2);
		const material = new MeshLambertMaterial();
		for (const { x, y } of pixels) {
			const mesh = new Mesh(block, material);
			mesh.position.set(x / cell - 8, 2 - y / cell, 0);
			word.add(mesh);
		}
		scene.add(word);

		// Motion drives the rotation: spring into the resting pose, then sway until dragged.
		const rot = word.rotation;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let playing: ReturnType<typeof animate> | undefined;
		let last: PointerEvent | undefined; // previous pointer event while dragging

		const sway = () => {
			playing = animate(
				rot,
				{ y: [REST.y, -REST.y] },
				{ duration: 6, ease: 'easeInOut', repeat: Infinity, repeatType: 'mirror' },
			);
		};
		const settle = (delay = 0) => {
			if (reduced) {
				rot.set(REST.x, REST.y, 0);
				return;
			}
			playing = animate(rot, REST, {
				type: 'spring',
				stiffness: 50,
				damping: 6,
				delay,
				onComplete: () => last || sway(),
			});
		};
		settle(0.9); // starts face-on like the flat wordmark, turns once the figure has risen in

		pre.addEventListener('pointerdown', (e) => {
			playing?.stop();
			last = e;
			pre.setPointerCapture(e.pointerId);
		});
		pre.addEventListener('pointermove', (e) => {
			if (!last) return;
			rot.y += (e.clientX - last.clientX) * 0.01;
			rot.x = Math.max(-1, Math.min(1, rot.x + (e.clientY - last.clientY) * 0.01));
			last = e;
		});
		const release = () => {
			if (!last) return;
			last = undefined;
			rot.y = Math.atan2(Math.sin(rot.y), Math.cos(rot.y)); // drop full turns: spring back the short way
			settle();
		};
		pre.addEventListener('pointerup', release);
		pre.addEventListener('pointercancel', release);

		let shown = '';
		const frame = () => {
			// ClientRouter swapped the page out: free the GL context.
			if (!pre.isConnected) {
				playing?.stop();
				renderer.dispose();
				renderer.forceContextLoss();
				return;
			}
			renderer.setRenderTarget(target);
			renderer.render(scene, camera);
			renderer.readRenderTargetPixels(target, 0, 0, cols, rows, buffer);
			let text = '';
			// GL rows run bottom-up.
			for (let r = rows - 1; r >= 0; r--) {
				for (let c = 0; c < cols; c++)
					text += RAMP[Math.round((buffer[(r * cols + c) * 4] / 255) * (RAMP.length - 1))];
				if (r) text += '\n';
			}
			if (text !== shown) pre.textContent = shown = text;
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}

	// Runs on first load and after every ClientRouter navigation (the script itself runs once).
	document.addEventListener('astro:page-load', () => {
		const pre = document.querySelector<HTMLElement>('[data-ascii-wordmark]');
		if (pre) mount(pre);
	});
</script>
