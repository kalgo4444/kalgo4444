---
// Page h1 with the terminal typing effect; --n (character count) sizes the animation.
interface Props {
	text: string;
	order?: number;
}

const { text, order } = Astro.props;
---

<h1
	class:list={['type text-[28px] leading-normal font-bold text-ink sm:text-[32px] lg:text-[38px]', { rise: order }]}
	style={`--n: ${text.length}` + (order ? `; --i: ${order}` : '')}
>
	{text}
</h1>
