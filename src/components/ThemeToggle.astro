<button
	type="button"
	data-theme-toggle
	aria-label="Toggle dark mode"
	class="inline-flex size-11 items-center justify-center rounded-sm text-mute transition-transform hover:text-ink motion-safe:active:scale-90 md:size-10"
>
	<svg
		viewBox="0 0 24 24"
		class="size-5 dark:hidden"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
		></path>
	</svg>
	<svg
		viewBox="0 0 24 24"
		class="hidden size-5 dark:block"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path
			d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
		></path>
	</svg>
</button>

<script>
	// Global from the inline script in Layout.astro.
	declare const applyTheme: () => void;

	document.addEventListener('click', (e) => {
		if (!(e.target as Element).closest('[data-theme-toggle]')) return;
		const root = document.documentElement;
		root.classList.add('theme-fade');
		setTimeout(() => root.classList.remove('theme-fade'), 450);
		localStorage.setItem('theme', root.classList.contains('dark') ? 'light' : 'dark');
		applyTheme();
	});
</script>
